#!/usr/bin/env bash

cd "$(dirname "$0")/.." || exit 1

untracked=$(git ls-files --others --exclude-standard src tests)

restore() {
    if [ -n "$untracked" ]; then
        git reset --quiet -- $untracked
    fi
}

trap restore EXIT

if [ -n "$untracked" ]; then
    git add --intent-to-add -- $untracked
fi

# Infection narrows the PHPUnit coverage filter to the changed files. When the
# only changes are in paths excluded by `<source><exclude>` in phpunit.dist.xml,
# that filter matches nothing and PHPUnit aborts the initial run with
# "No tests executed!" (a configuration problem, not a failing test suite).
if ! git diff --name-only origin/develop -- src tests |
    grep -qvE '^src/(Config|Views|Language|Database/Migrations)/'; then
    echo 'No changes to tested source code detected, skipping mutation testing.'
    exit 0
fi

vendor/bin/infection \
    --static-analysis-tool=phpstan \
    --with-uncovered \
    --git-diff-lines \
    --git-diff-base=origin/develop \
    "$@"
